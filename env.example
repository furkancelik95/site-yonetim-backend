# Bu dosya yer tutucudur. Gerçek değerler .env dosyasına yazılır (.env repoya GİRMEZ).
# Kurulum: cp env.example .env
ENVIRONMENT=development          # development | test | production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/site_yonetim
# Üretimde en az 32 karakter, rastgele: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=__SET_ME__
JWT_ACCESS_MINUTES=15
FILE_STORAGE_ROOT=./var/files     # web kökünün DIŞINDA
CORS_ORIGINS=http://localhost:5173   # virgülle ayrılmış; '*' kabul edilmez
ALLOWED_HOSTS=localhost,127.0.0.1    # Host başlığı beyaz listesi; üretimde API alan adı
API_DOCS_ENABLED=true             # /api/v1/docs ve openapi.json; üretimde false
LOG_LEVEL=INFO
SEED_DEMO_DATA=true               # yalnız development'ta etkili
