# Bu dosya yer tutucudur. Gerçek değerler .env dosyasına yazılır (.env repoya GİRMEZ).
# Kurulum: cp env.example .env
# Rastgele parola/sır üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=development          # development | test | production

# --- Veritabanı (docs/02-mimari.md §3) ---
# Uygulama rolü: süper kullanıcı değil, RLS'e tabi. Uygulama YALNIZ bununla bağlanır.
DATABASE_URL=postgresql+asyncpg://site_yonetim_app:APP_PASSWORD@localhost:5432/site_yonetim
# Tablo sahibi: yalnız göçler (alembic upgrade head).
DATABASE_ADMIN_URL=postgresql+asyncpg://site_yonetim_owner:OWNER_PASSWORD@localhost:5432/site_yonetim
# docker compose'daki db servisi için (docker/postgres/10-roles.sh rolleri bunlarla kurar)
POSTGRES_PASSWORD=__SET_ME__
DB_OWNER_PASSWORD=__SET_ME__     # DATABASE_ADMIN_URL'deki OWNER_PASSWORD ile aynı
DB_APP_PASSWORD=__SET_ME__       # DATABASE_URL'deki APP_PASSWORD ile aynı

# Entegrasyon testleri (ayrı veritabanı: APP_DB_NAME=site_yonetim_test ile 10-roles.sh)
# TEST_DATABASE_URL=postgresql+asyncpg://site_yonetim_app:APP_PASSWORD@localhost:5432/site_yonetim_test
# TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://site_yonetim_owner:OWNER_PASSWORD@localhost:5432/site_yonetim_test

# --- Güvenlik ---
# Üretimde en az 32 karakter, rastgele
JWT_SECRET=__SET_ME__
JWT_ACCESS_MINUTES=15
SESSION_HOURS=8                   # oturum (yenileme jetonu) ömrü, kayan pencere
REFRESH_COOKIE_SECURE=false       # yerelde http için false; üretimde true (zorunlu)
CORS_ORIGINS=http://localhost:5173   # virgülle ayrılmış; '*' kabul edilmez
# IP bazlı giriş hız sınırı: pencerede bu kadar hatalı denemeden sonra 429 (docs/05 §8.1)
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_MINUTES=15
# Ters vekil (nginx, yük dengeleyici) arkasında: vekilin adresi. Yalnız oradan gelen
# X-Forwarded-For güvenilir. Verilmezse hız sınırı ve denetim kaydı vekilin IP'sini görür.
# FORWARDED_ALLOW_IPS=10.0.0.5
ALLOWED_HOSTS=localhost,127.0.0.1    # Host başlığı beyaz listesi; üretimde API alan adı
API_DOCS_ENABLED=true             # /api/v1/docs ve openapi.json; üretimde false

FILE_STORAGE_ROOT=./var/files     # web kökünün DIŞINDA
# Onay bekleyen Excel aktarımları (6 saat tutulur). Boşsa sistemin geçici klasörü;
# birden çok API kopyasında ortak bir birim verin.
# IMPORT_STORAGE_DIR=/var/lib/site-yonetim/imports
LOG_LEVEL=INFO
SEED_DEMO_DATA=true               # yalnız development'ta etkili
